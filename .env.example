# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# .env читают и приложение (src/settings.py), и docker compose.

# --- Основная БД ---
# При запуске через docker compose хост и порт переопределяются на имя сервиса,
# менять их для этого не нужно: значения ниже используются, когда приложение
# запускают на хосте (uvicorn src.main:app --reload)
DB_USER=user
DB_PASSWORD=смените-меня
DB_HOST=127.0.0.1
DB_PORT=5435
DB_NAME=money_tracker

# --- Тестовая БД (нужна только для pytest) ---
TEST_DB_USER=user
TEST_DB_PASSWORD=смените-меня
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5436
TEST_DB_NAME=money_tracker_test

# --- Redis (ограничение попыток входа) ---
REDIS_URL=redis://127.0.0.1:6379/0
TEST_REDIS_URL=redis://127.0.0.1:6379/1

# --- Токены ---
# Ключ подписи JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_TOKEN_KEY=смените-меня
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# false нужен, только если фронт открывают по http не с localhost:
# браузер не сохранит Secure-cookie с refresh-токеном
REFRESH_COOKIE_SECURE=true

# --- GigaChat (функции на основе LLM) ---
# Ключ авторизации (Authorization Key) из личного кабинета developers.sber.ru:
# проект GigaChat API → «Настройки API». Без ключа приложение работает,
# а функции на основе LLM отвечают 503
GIGACHAT_CREDENTIALS=
# GigaChat-2 — это Lite; GigaChat-2-Pro точнее следует инструкциям, но в разы дороже
GIGACHAT_MODEL=GigaChat-2

# --- Прочее ---
SERVICE_URL=http://localhost:8000
# Источники, которым разрешены запросы из браузера (JSON-список)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
